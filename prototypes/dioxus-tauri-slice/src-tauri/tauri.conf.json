{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dioxus-tauri-slice",
  "version": "0.0.1",
  "identifier": "dev.leitner.dioxus-tauri-slice",
  "build": {
    "beforeDevCommand": "cd ui && dx serve --platform web --port 8112",
    "devUrl": "http://localhost:8112",
    "beforeBuildCommand": "cd ui && dx build --platform web",
    "frontendDist": "../target/dx/slice-ui-dx/debug/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dioxus+Tauri slice · #8",
        "width": 560,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: four stacked stones, largest at the base, the crown stone in the
     accent colour, deliberately irregular because a cairn is stacked rather than manufactured.
     All four sit inside the 66dp safe circle (centre 54,54, radius ~32) of the 108dp canvas, so no
     OEM mask — circle, squircle, rounded square — crops a stone. Drawn base-first so the stack
     reads as resting one on another. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- base stone -->
    <path
        android:fillColor="#E8E2D6"
        android:pathData="M28,70 C28,64 36,62 50,62 C64,61 80,63 80,70 C80,76 70,80 54,80 C40,80 28,76 28,70 Z" />
    <!-- second stone -->
    <path
        android:fillColor="#E8E2D6"
        android:pathData="M33,57 C33,51 40,49 52,49 C65,48 77,50 77,57 C77,62 68,65 55,65 C43,65 33,63 33,57 Z" />
    <!-- third stone -->
    <path
        android:fillColor="#E8E2D6"
        android:pathData="M36,45 C36,40 42,38 52,38 C62,37 70,39 70,45 C70,50 62,52 52,52 C42,52 36,50 36,45 Z" />
    <!-- crown stone, accent -->
    <path
        android:fillColor="#E4A951"
        android:pathData="M43,33 C43,29 47,27 54,27 C61,27 65,30 64,34 C64,38 59,40 53,40 C47,40 43,37 43,33 Z" />
</vector>

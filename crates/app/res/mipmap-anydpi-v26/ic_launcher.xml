<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on API 26+. `anydpi-v26` is density-agnostic: the three vector layers below
     are rendered by the framework at whatever density the launcher asks for, so there are no raster
     buckets to keep in step. The same entry serves both the square and the round icon request,
     because the OEM mask — not a separate asset — makes it round. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

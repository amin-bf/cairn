+/// **Prototype #163 — Persian.** Which of three answers the editor draws for a right-to-left note,
+/// seeded from `CAIRN_PERSIAN` so a capture can photograph each: `0` (or unset) is what ships — only
+/// content follows its script — `1` puts each field's label on its own field's reading side, and `2`
+/// mirrors the whole editor on the prompt's direction. Never merges.
+#[derive(Clone, Copy, PartialEq)]
+enum PersianKnob {
+    Shipped,
+    LabelsFollow,
+    Mirror,
+}
+
+fn persian_knob() -> PersianKnob {
+    match std::env::var("CAIRN_PERSIAN").as_deref() {
+        Ok("1") => PersianKnob::LabelsFollow,
+        Ok("2") => PersianKnob::Mirror,
+        _ => PersianKnob::Shipped,
+    }
+}
+
+/// Knob `2`, on a note whose **prompt** — its first field — reads right to left, which is ADR-0033
+/// §5's governor for the box badge.
+fn editor_mirrored(ed: &Editing) -> bool {
+    persian_knob() == PersianKnob::Mirror && ed.fields.first().is_some_and(|(_, v)| bidi::is_rtl(v))
+}
+
+/// Draw `add` against the right edge when `rtl`, and as usual otherwise.
+fn reading_side<R>(ui: &mut egui::Ui, rtl: bool, add: impl FnOnce(&mut egui::Ui) -> R) -> R {
+    if rtl {
+        ui.with_layout(Layout::right_to_left(Align::Min), add).inner
+    } else {
+        add(ui)
+    }
+}
